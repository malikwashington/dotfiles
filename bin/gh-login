#!/usr/bin/env bash
# Log this machine into GitHub and wire git (and anything using it, like uv) up
# to the token, so cloning a private repo over https works.
#
# Usage: gh-login            browser flow (gh's own OAuth app)
#        gh-login --token    paste a fine-grained PAT instead, read from stdin
#
# Prefer --token on a machine you don't fully trust: a fine-grained token can be
# limited to read-only Contents on specific repos and revoked on its own, while
# the browser flow grants repo/workflow/gist across the whole account.
set -euo pipefail

HOST=github.com
say()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m  %s\n' "$*"; }

command -v gh >/dev/null || { warn "gh not installed: brew bundle (see Brewfile)"; exit 1; }

if gh auth status --hostname "$HOST" >/dev/null 2>&1; then
  say "already logged in"
else
  if [[ "${1:-}" == "--token" ]]; then
    say "paste a fine-grained PAT, then ctrl-d"
    echo "    create one at https://github.com/settings/personal-access-tokens/new"
    echo "    scope it to: Contents = Read-only, only the repos you need"
    gh auth login --hostname "$HOST" --git-protocol https --with-token
  else
    say "opening the browser"
    gh auth login --hostname "$HOST" --git-protocol https --web
  fi
fi

# Homebrew's git already points at osxkeychain (see /opt/homebrew/etc/gitconfig),
# so a private clone works once you've pasted a token into the keychain by hand.
# This makes git read the gh token directly instead, so there's no prompt at all.
say "wiring git up to the token"
gh auth setup-git --hostname "$HOST"

say "status"
gh auth status --hostname "$HOST" || true
echo
echo "    revoke this machine's access any time at:"
echo "    https://github.com/settings/applications  (browser flow)"
echo "    https://github.com/settings/personal-access-tokens  (PAT)"

#!/usr/bin/env bash
# Log this machine out of GitHub: drop the token and remove the git credential
# helper that gh-login installed, so nothing is left able to reach your account.
#
# This only clears the credential *locally*. It does not revoke the token
# server-side — the URLs printed at the end do that.
set -euo pipefail

HOST=github.com
say()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m  %s\n' "$*"; }

command -v gh >/dev/null || { warn "gh not installed"; exit 1; }

if gh auth status --hostname "$HOST" >/dev/null 2>&1; then
  say "logging out of $HOST"
  gh auth logout --hostname "$HOST"
else
  say "not logged in to $HOST"
fi

# gh auth setup-git writes these; left behind, git fails on every github fetch
say "removing the git credential helper"
for h in "https://$HOST" "https://gist.$HOST"; do
  if git config --global --get-regexp "^credential\.${h//./\\.}\." >/dev/null 2>&1; then
    echo "    unset credential.$h.helper"
    git config --global --unset-all "credential.$h.helper" 2>/dev/null || true
  fi
done

# the credential that actually answers a private clone on this Mac lives in the
# login keychain (Homebrew's git sets credential.helper=osxkeychain system-wide),
# and gh auth logout does not touch it. `git credential reject` asks whatever
# helpers are configured to forget it.
say "erasing the keychain credential"
for h in "$HOST" "gist.$HOST"; do
  printf 'protocol=https\nhost=%s\n\n' "$h" | git credential reject 2>/dev/null || true
  echo "    rejected https://$h"
done

say "what's left"
if remaining="$(git config --global --get-regexp '^credential' 2>/dev/null)"; then
  echo "$remaining" | sed 's/^/    /'
else
  echo "    no credential config"
fi
gh auth status 2>&1 | sed 's/^/    /' || true
# GIT_TERMINAL_PROMPT=0 so this check can never sit waiting for input
if cred="$(printf 'protocol=https\nhost=%s\n\n' "$HOST" | GIT_TERMINAL_PROMPT=0 git credential fill 2>/dev/null)" \
   && grep -q '^password=' <<<"$cred"; then
  warn "a credential for $HOST is still reachable — check: git config --list --show-origin | grep credential"
else
  echo "    no credential for $HOST"
fi
echo
echo "    this only cleared the local copy. revoke it for real at:"
echo "    https://github.com/settings/applications  (browser flow)"
echo "    https://github.com/settings/personal-access-tokens  (PAT)"

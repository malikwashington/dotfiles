# zshrc — tracked in dotfiles. Machine-specific settings go in ~/.zshrc.local (untracked).

# ---------- PATH ----------
# this file's repo, resolved through the ~/.zshrc symlink (.../dotfiles/zsh/zshrc -> .../dotfiles)
DOTFILES="${${(%):-%N}:A:h:h}"

typeset -U path fpath                # dedupe entries

# Homebrew first — also sets HOMEBREW_PREFIX, MANPATH, INFOPATH
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# pyenv — shims must precede Homebrew's python
export PYENV_ROOT="$HOME/.pyenv"
[ -d "$PYENV_ROOT/bin" ] && path=("$PYENV_ROOT/bin" $path)

# Go
export GOPATH="$HOME/go"
[ -d "$GOPATH/bin" ] && path+=("$GOPATH/bin")

# own scripts: this repo's bin/, then any machine-local ones
for d in "$DOTFILES/bin" "$HOME/bin" "$HOME/.local/bin"; do
  [ -d "$d" ] && path+=("$d")
done
export PATH

# ---------- Set Defaults ----------
export EDITOR='vim'

# ---------- shell options ----------
setopt auto_cd                       # `Documents` on its own means `cd Documents`
setopt auto_pushd pushd_ignore_dups pushd_silent   # cd keeps a stack: `cd -2`
setopt interactive_comments          # allow `#` comments when pasting commands
setopt no_beep                       # /etc/zshrc turns BEEP on; turn it back off
unsetopt flow_control                # free up ctrl-s / ctrl-q

# ---------- history ----------
# /etc/zshrc caps these at 2000/1000 — raise them and dedupe
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt share_history                 # one history across all open shells
setopt extended_history              # record timestamp + duration
setopt hist_ignore_all_dups          # a repeated command keeps only its newest entry
setopt hist_ignore_space             # a leading space keeps a command out of history
setopt hist_reduce_blanks            # tidy whitespace before saving
setopt hist_verify                   # show an expanded `!!` instead of running it blind

# ---------- completion ----------
# Homebrew's completions (git, brew, docker, ...) live here; must precede compinit
[ -d "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions" ] &&
  fpath=("${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions" $fpath)

zmodload zsh/complist               # the interactive completion menu
autoload -Uz compinit
# rebuild the completion cache at most once a day, so new shells start fast
() {
  setopt local_options extended_glob
  local dump="$HOME/.zcompdump"
  if [[ -n $dump(#qN.mh-24) ]]; then
    compinit -C -d $dump             # cache is fresh: trust it, skip the scan
  else
    compinit -i -d $dump             # rebuild; -i ignores group-writable brew dirs
  fi
}

setopt complete_in_word              # complete from the cursor, not just end of word
setopt always_to_end                 # ...then put the cursor at the end
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z-_}={A-Za-z_-}'   # case/dash-insensitive
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}%B%d%b%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh/compcache"

# ---------- aliases: editing this config ----------
alias zshrc='vim ~/.zshrc'
alias vimrc='vim ~/.vim/vimrc'
alias tmuxconf='vim ~/.config/tmux/tmux.conf'
alias sourced='source ~/.zshrc'

# ---------- aliases: modern replacements (only if installed) ----------
if command -v eza >/dev/null; then
  alias ls='eza --icons auto'
  alias tree='ls --tree'
fi
alias ll='ls -l'                     # inherits the eza alias when present
alias la='ls -la'
command -v bat >/dev/null && alias cat='bat'
alias code='code --new-window'

# ---------- aliases: tools ----------
command -v herdr >/dev/null && alias h='herdr'      # agent multiplexer

# ---------- aliases: python ----------
alias py='python3'
alias venv='virtualenv env'
alias bina='source env/bin/activate'
alias prr='pip3 install -r requirements.txt'
alias pfr='pip3 freeze > requirements.txt'
alias pm='python manage.py'
alias pmig='python manage.py makemigrations && python manage.py migrate'

# ---------- aliases: node ----------
alias ni='npm install'
alias nrs='npm run start'
alias nrd='npm run dev'

# ---------- aliases: git ----------
alias gc='git commit -am'
alias gp='git push --set-upstream origin'
alias gs='git switch'

# ---------- work ----------
alias co='copilot'
alias windows='say "Good Morning! This is the start of something great!" && caffeinate -di open -a "Windows App" -W && say "Work session closed. Have a good night."'

# ---------- personal cli tooling ----------
# Scripts in $DOTFILES/bin are on PATH (see above); installed tools are listed per language.

# -- bash --  ($DOTFILES/bin, on PATH above)
#   sheet     Google Sheets bridge; reads its creds from 1Password.
#   gh-logout one-off: purge a stored github https token from this Mac's
#             keychain and gh's keyring. Unrelated to ghon/ghoff below.

# -- go --  (github.com/malikwashington/cli-tools -> ~/Documents/cli-tools,
#            built into $GOPATH/bin by install.sh)
#   logq      query log files
#   notify    run a command and get notified when it finishes
#   portkill  kill whatever is listening on a port
command -v portkill >/dev/null && alias pk='portkill'

# -- python --
#   mp3book   audiobook builder, required by the mp3book Alfred workflow.
#             install: uv tool install mp3book

# ---------- github ssh key (session-only) ----------
# The private key lives in 1Password and is never written to this machine.
# ghon reads it straight into ssh-agent's memory; ghoff takes it back out.
# --apple-use-keychain is deliberately not used, so the key does not survive
# ghoff, the TTL expiring, a logout or a reboot.
#
# 1Password's own SSH agent would be tighter — the key would never leave the
# vault — but its authorisation ends when 1Password locks, and this Mac locks
# it every few minutes. In ssh-agent the lock state doesn't reach the key.
#
# Override any of these in ~/.zshrc.local. The ?ssh-format=openssh on the
# private key is required: without it 1Password hands back a different format.
: ${GH_SSH_KEY_REF:=op://Private/Github SSH Key/private key?ssh-format=openssh}
: ${GH_SSH_PUB_REF:=op://Private/Github SSH Key/public key}
: ${GH_SSH_TTL:=8h}

ghon() {
  command -v op >/dev/null || { print -u2 "ghon: op not installed (run install.sh)"; return 1 }
  # ssh-add exits 2 when it can't reach an agent at all, 1 when it's merely empty
  ssh-add -l >/dev/null 2>&1
  if (( $? == 2 )); then
    print -u2 "ghon: no ssh-agent reachable (SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-unset})"
    return 1
  fi
  local key
  if ! key="$(op read "$GH_SSH_KEY_REF" 2>&1)"; then
    print -u2 "ghon: couldn't read $GH_SSH_KEY_REF"
    print -u2 "      $key"
    print -u2 "      1Password locked, or op not signed in? try: eval \$(op signin)"
    return 1
  fi
  [[ -n "$key" ]] || { print -u2 "ghon: $GH_SSH_KEY_REF holds nothing"; return 1 }

  # print -r adds the trailing newline that ssh-add requires and $(...) strips
  if ! print -r -- "$key" | ssh-add -t "$GH_SSH_TTL" - 2>&1; then
    print -u2 "ghon: ssh-add refused it — is that field the private key?"
    return 1
  fi
  print "ghon: loaded for $GH_SSH_TTL, in ssh-agent memory only"
  print "      verify with: ssh -T git@github.com"
}

ghoff() {
  local pub
  if command -v op >/dev/null && pub="$(op read "$GH_SSH_PUB_REF" 2>/dev/null)" && [[ -n "$pub" ]]; then
    # remove just this key, so other loaded identities are left alone
    if print -r -- "$pub" | ssh-add -d - 2>/dev/null; then
      print "ghoff: removed from ssh-agent"
    else
      print "ghoff: that key wasn't loaded"
    fi
  else
    # can't read the public key to identify ours (1Password locked?), so clear
    # everything rather than leave it loaded
    print -u2 "ghoff: couldn't read $GH_SSH_PUB_REF (1Password locked?)"
    print -u2 "       clearing every identity instead, to be safe"
    ssh-add -D 2>/dev/null || true
  fi
  print "ghoff: agent now holds: $(ssh-add -l 2>&1)"
}

# signoff — leaving this Mac: drop every credential this config can load.
# ghoff deliberately stays narrow (just the key, so it's usable as a toggle);
# this is the teardown that does the lot.
signoff() {
  ghoff

  # any other identity in the agent goes too — a teardown, not a toggle
  if ssh-add -l >/dev/null 2>&1; then
    ssh-add -D >/dev/null 2>&1 && print "signoff: cleared the remaining ssh-agent identities"
  fi

  # op CLI session. `unset -m` takes a pattern; $parameters would need
  # zmodload zsh/parameter, and silently misbehaves without it.
  local had=""
  [[ -n "$(typeset +m 'OP_SESSION_*')" ]] && had=yes
  if command -v op >/dev/null; then
    op signout --all >/dev/null 2>&1 || true
    unset -m 'OP_SESSION_*'
    if [[ -n "$had" ]]; then
      print "signoff: closed the op CLI session"
    else
      print "signoff: op signed out (no session variables were set)"
    fi
  fi

  # a github https token, if gh-login was ever run here: keychain + gh keyring
  if command -v gh-logout >/dev/null; then
    gh-logout
  fi

  print "signoff: done"
}

# ---------- functions ----------
# fuzzy cd: pick a directory under $1 (default .) with fzf
fcd() {
  local dir
  dir=$(find "${1:-.}" -type d -not -path '*/.*' 2>/dev/null | fzf +m) && cd "$dir"
}

# yazi: file manager in the terminal
y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# take: mkdir+cd, or download+extract a tarball, or clone a git repo — then cd into it
# (same behaviour as oh-my-zsh's, without the dependency)
takeurl() {
  local data thedir
  data="$(mktemp)"
  curl -L "$1" > "$data"
  tar xf "$data"
  thedir="$(tar tf "$data" | head -n 1)"
  rm "$data"
  cd "$thedir"
}

takegit() {
  git clone "$1"
  cd "$(basename ${1%%.git})"
}

# mkcd is equivalent to takedir
mkcd takedir() {
  mkdir -p $@ && cd ${@:$#}
}

take() {
  if [[ $1 =~ ^(https?|ftp).*\.tar\.(gz|bz2|xz)$ ]]; then
    takeurl "$1"
  elif [[ $1 =~ ^([A-Za-z0-9]\+@|https?|git|ssh|ftps?|rsync).*\.git/?$ ]]; then
    takegit "$1"
  else
    takedir "$@"
  fi
}

# ---------- tool hooks (no-op when the tool is absent) ----------
command -v pyenv    >/dev/null && eval "$(pyenv init -)"
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v fzf      >/dev/null && eval "$(fzf --zsh)"
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"      # z
command -v direnv   >/dev/null && eval "$(direnv hook zsh)"
command -v fnm      >/dev/null && eval "$(fnm env --use-on-cd --shell zsh)"

# google cloud sdk
[ -f "$HOME/google-cloud-sdk/path.zsh.inc" ] && source "$HOME/google-cloud-sdk/path.zsh.inc"
[ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ] && source "$HOME/google-cloud-sdk/completion.zsh.inc"

# ---------- zsh plugins (must be last) ----------
BREW_SHARE="${HOMEBREW_PREFIX:-/opt/homebrew}/share"
[ -f "$BREW_SHARE/zsh-autosuggestions/zsh-autosuggestions.zsh" ] &&
  source "$BREW_SHARE/zsh-autosuggestions/zsh-autosuggestions.zsh"

# Tab accepts the autosuggestion when one is showing, otherwise completes as usual
_tab_accept_or_complete() {
  if [[ -n "$POSTDISPLAY" ]]; then
    zle autosuggest-accept
  else
    zle expand-or-complete
  fi
}
zle -N _tab_accept_or_complete
bindkey '^I' _tab_accept_or_complete

# syntax highlighting wraps the widgets above, so it loads after them
[ -f "$BREW_SHARE/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] &&
  source "$BREW_SHARE/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
unset BREW_SHARE

# ---------- machine-specific overrides (not tracked) ----------
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

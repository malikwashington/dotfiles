# Copy to ~/.zshrc.local and edit. This file is NOT tracked in git.

# Java: newest installed JDK (pin with e.g. `java_home -v 21`)
if [ -x /usr/libexec/java_home ] && /usr/libexec/java_home >/dev/null 2>&1; then
  export JAVA_HOME="$(/usr/libexec/java_home)"
  path+=("$JAVA_HOME/bin")
fi

# MySQL (official .pkg installs to /usr/local/mysql)
[ -d /usr/local/mysql/bin ] && path+=(/usr/local/mysql/bin)

# personal servers
alias sb='ssh -i ~/.ssh/aws.pem ubuntu@YOUR_SERVER_IP'

# github ssh key for ghon — the 1Password SSH Key item holding it.
# List candidates with: op item list --categories "SSH Key"
# ?ssh-format=openssh is required on the private key, or you get the wrong format
# export GH_SSH_KEY_REF='op://Private/Github SSH Key/private key?ssh-format=openssh'
# export GH_SSH_PUB_REF='op://Private/Github SSH Key/public key'
# export GH_SSH_TTL=8h

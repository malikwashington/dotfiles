# Shared git settings — linked to ~/.config/git/config by install.sh.
#
# Appearance and workflow only: no identity, no credential helpers. git reads
# this file *before* ~/.gitconfig, so anything in ~/.gitconfig (user.email,
# credential helpers, a work machine's managed settings) overrides it.
# install.sh never touches ~/.gitconfig.
[pull]
	rebase = false
[core]
	editor = code --wait
	pager = delta
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true          # n / N jump between files in a diff
	line-numbers = true
[merge]
	conflictStyle = zdiff3   # shows the common ancestor; delta renders it
[color]
	ui = true
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
